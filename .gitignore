# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# documentacion de proveedores (contiene credenciales, no commitear)
docs/*.pdf

# exportaciones de Google Ads (datos de cuenta, no commitear)
/datos-ads/

# Fondos de prueba para `?fondo=2` de la ruta de muestra. Son generaciones
# guardadas a mano para poder depurar la COMPOSICION sin pagar una llamada por
# intento; pesan ~1 MB y no son parte del sistema, asi que no viajan en el repo.
fixtures/

# fuentes cacheadas para componer el titular de las portadas de LinkedIn
/scripts/.fuentes
